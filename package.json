{
  "name": "frozen-earth",
  "private": true,
  "version": "0.1.0",
  "description": "A browser-based multiplayer colony sim. Winter is coming from the edges of the world.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch apps/server/src/main.ts --world dev",
    "dev:client": "vite --config apps/client/vite.config.ts",
    "build": "vite build --config apps/client/vite.config.ts",
    "start": "tsx apps/server/src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "bots": "tsx tools/bots/src/main.ts",
    "smoke": "tsx tools/bots/src/smoke.ts",
    "docs:events": "tsx tools/docs/events-doc.ts",
    "bench": "tsx tools/bench/sim.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  }
}
